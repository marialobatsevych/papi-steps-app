{
  "name": "papi-steps-app",
  "version": "2.9.1",
  "description": "Papi Steps - A kawaii wellness game with a cute puppy companion",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "capacitor:init": "npx cap init",
    "capacitor:add:ios": "npx cap add ios",
    "capacitor:add:android": "npx cap add android",
    "capacitor:sync": "npx cap sync",
    "capacitor:open:ios": "npx cap open ios",
    "capacitor:open:android": "npx cap open android",
    "capacitor:copy": "npx cap copy",
    "capacitor:update": "npx cap update",
    "ios:build": "npm run build && npx cap sync ios && npx cap open ios",
    "android:build": "npm run build && npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
